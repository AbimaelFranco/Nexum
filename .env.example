# Copia este archivo a `.env` y completa los valores reales.
# `.env` NUNCA debe subirse al repositorio (ya está en .gitignore).

# --- Telegram ---
# Obtén el token hablando con @BotFather en Telegram (ver README.md).
TELEGRAM_BOT_TOKEN=

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- PostgreSQL ---
POSTGRES_USER=nexum
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nexum
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
